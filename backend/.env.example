# ─── Copy this file to .env and fill in your values ───────────────────────────
# NEVER commit .env to git — it's already in .gitignore

# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose will set this automatically.
# For local dev outside Docker use: postgresql://pfm_user:pfm_pass@localhost:5432/pfm_db
DATABASE_URL=postgresql://pfm_user:pfm_pass@db:5432/pfm_db

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_real_secret_key_here
JWT_ALGORITHM=HS256
# Token expiry in minutes (1440 = 24 hours, 10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
